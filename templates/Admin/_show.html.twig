{% if messages %}
	<div id='orderMessage' class="ui segment">
		{% for message in messages %}
			<div class="ui segment">
				{{ 'threebrs.orderMessage.sender'|trans }} {{ message.sender.username }}
				<br><br>
				{% if message.sendMail %}
					{{ 'threebrs.orderMessage.message'|trans }}
				{% else %}
					{{ 'threebrs.orderMessage.note'|trans }}
				{% endif %}
				<br>
				{{ message.message }}
				<br>
				{% if message.sendMail %}
					<br>
					{{ 'threebrs.orderMessage.sent'|trans }}
				{% endif %}
				<br>
				{{ 'threebrs.orderMessage.time'|trans }} {{ message.sendTime|date('Y-m-d H:i:s') }}

			</div>
		{% endfor %}
	</div>
{% endif %}
