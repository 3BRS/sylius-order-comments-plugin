{
    "name": "3brs/sylius-order-comments-plugin",
    "type": "sylius-plugin",
    "keywords": ["sylius", "sylius-plugin"],
    "description": "Order comments plugin for Sylius",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "sylius/sylius": ">=1.12 <2.0"
    },
    "require-dev": {
        "behat/behat": "^3.4",
        "behat/mink": "^1.7@dev",
        "friends-of-behat/mink-browserkit-driver": "^1.6",
        "friends-of-behat/mink-extension": "^2.4",
        "friends-of-behat/mink-debug-extension": "^2.0",
        "friends-of-behat/page-object-extension": "^0.3",
        "friends-of-behat/suite-settings-extension": "^1.0",
        "friends-of-behat/symfony-extension": "^2.0",
        "friends-of-behat/variadic-extension": "^1.1",
        "phpstan/phpstan": "^1.0",
        "phpstan/phpstan-doctrine": "^1.0",
        "phpstan/phpstan-symfony": "^1.3",
        "phpstan/phpstan-webmozart-assert": "^1.0",
        "phpunit/phpunit": "^9.6|^10.0",
        "polishsymfonycommunity/symfony-mocker-container": "^1.0",
        "symfony/browser-kit": "^6.4",
        "symfony/debug-bundle": "^6.4",
        "symfony/dotenv": "^6.4",
        "symfony/framework-bundle": "^6.4",
        "symfony/http-foundation": "^6.4",
        "symfony/http-kernel": "^6.4",
        "symfony/intl": "^6.4",
        "symfony/security-bundle": "^6.4",
        "symfony/web-profiler-bundle": "^6.4",
        "symfony/webpack-encore-bundle": "^1.16|^2.0",
        "doctrine/annotations": "^1.14|^2.0"
    },
    "conflict": {
        "api-platform/core": "<2.7.13",
        "babdev/pagerfanta-bundle": "<3.7.0",
        "doctrine/collections": "<1.7.0",
        "doctrine/data-fixtures": "<1.5.1",
        "doctrine/dbal": "<2.13.3",
        "doctrine/doctrine-bundle": "<2.8.0",
        "friends-of-behat/mink-browserkit-driver": "<1.6.3",
        "friends-of-behat/mink-debug-extension": "<2.1.0",
        "friends-of-behat/mink-extension": "<2.7.5",
        "friends-of-behat/symfony-extension": "<2.6.2",
        "friends-of-behat/variadic-extension": "<1.7.0",
        "friendsofsymfony/rest-bundle": "<3.1.0",
        "jms/serializer-bundle": "<4.2.0",
        "knplabs/knp-menu": "<3.3.0",
        "knplabs/knp-menu-bundle": "<3.5.0",
        "lexik/jwt-authentication-bundle": "<2.12",
        "masterminds/html5": "<2.7.5",
        "payum/payum-bundle": "<2.7.1",
        "polishsymfonycommunity/symfony-mocker-container": "<1.0.6",
        "sylius-labs/polyfill-symfony-security": "<1.1.2",
        "sylius/grid-bundle": "<1.11.0",
        "sylius/resource-bundle": "<1.11.0",
        "symfony/css-selector": "<4.4.24",
        "symfony/error-handler": "<6.4.10",
        "symfony/framework-bundle": ">=5.4.0 <=5.4.20|>=6.0.0 <=6.0.16|>=6.1.0 <=6.1.8|>=6.2.0 <=6.2.2|6.2.8",
        "symfony/mime": "<5.4.0",
        "symfony/web-link": "<5.3.0",
        "twig/intl-extra": "<3.0",
        "twig/twig": "<2.14.7",
        "webmozart/assert": "<1.11.0",
        "willdurand/negotiation": "<3.0"
    },
    "config": {
        "audit": {
            "block-insecure": false
        },
        "allow-plugins": {
            "symfony/thanks": false
        }
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "MangoSylius\\OrderCommentsPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": ["tests/Application/Kernel.php"],
        "psr-4": {
            "Tests\\MangoSylius\\OrderCommentsPlugin\\": "tests/"
        }
    }
}
