{
    "name": "mangoweb-sylius/sylius-order-comments-plugin",
    "type": "sylius-plugin",
    "keywords": ["sylius", "sylius-plugin"],
    "description": "Order comments plugin for Sylius",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "sylius/sylius": "^2.0"
    },
    "require-dev": {
        "behat/behat": "^3.14",
        "behat/mink": "^1.11",
        "friends-of-behat/mink-browserkit-driver": "^1.6",
        "friends-of-behat/mink-extension": "^2.7",
        "friends-of-behat/mink-debug-extension": "^2.1",
        "friends-of-behat/page-object-extension": "^0.3",
        "friends-of-behat/suite-settings-extension": "^1.1",
        "friends-of-behat/symfony-extension": "^2.5",
        "friends-of-behat/variadic-extension": "^1.5",
        "phpstan/phpstan": "^1.10",
        "phpstan/phpstan-doctrine": "^1.3",
        "phpstan/phpstan-symfony": "^1.3",
        "phpstan/phpstan-webmozart-assert": "^1.2",
        "phpunit/phpunit": "^10.0|^11.0",
        "polishsymfonycommunity/symfony-mocker-container": "^1.0",
        "symfony/browser-kit": "^6.4|^7.4",
        "symfony/debug-bundle": "^6.4|^7.4",
        "symfony/dotenv": "^6.4|^7.4",
        "symfony/framework-bundle": "^6.4|^7.4",
        "symfony/http-foundation": "^6.4|^7.4",
        "symfony/http-kernel": "^6.4|^7.4",
        "symfony/dotenv": "^6.4|^7.4",
        "symfony/intl": "^6.4|^7.4",
        "symfony/maker-bundle": "^1.60",
        "symfony/web-profiler-bundle": "^6.4|^7.4",
        "symfony/webpack-encore-bundle": "^2.0",
        "nyholm/psr7": "^1.8",
        "php-http/discovery": "^1.20"
    },
    "conflict": {
        "symfony/var-exporter": ">=8.0",
        "symfony/error-handler": ">=8.0"
    },
    "config": {
        "audit": {
            "block-insecure": false
        },
        "allow-plugins": {
            "symfony/thanks": false,
            "php-http/discovery": true
        }
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "MangoSylius\\OrderCommentsPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": ["tests/Application/Kernel.php"],
        "psr-4": {
            "Tests\\MangoSylius\\OrderCommentsPlugin\\": "tests/"
        }
    }
}
