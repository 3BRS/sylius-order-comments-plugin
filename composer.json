{
    "name": "3brs/sylius-order-comments-plugin",
    "type": "sylius-plugin",
    "keywords": ["sylius", "sylius-plugin"],
    "description": "Order comments plugin for Sylius",
    "license": "MIT",
    "require": {
        "php": "^7.3",
        "sylius/sylius": ">=1.7 <=1.9"
    },
    "require-dev": {
        "behat/behat": "^3.4",
        "behat/mink": "^1.7@dev",
        "behat/mink-browserkit-driver": "^1.3",
        "behat/mink-extension": "^2.2",
        "behat/mink-selenium2-driver": "^1.3",
        "friends-of-behat/page-object-extension": "^0.3",
        "friends-of-behat/suite-settings-extension": "^1.0",
        "friends-of-behat/symfony-extension": "^2.0",
        "friends-of-behat/variadic-extension": "^1.1",
        "lakion/mink-debug-extension": "^1.2.3",
        "phpstan/phpstan": "^1.0",
        "phpstan/phpstan-doctrine": "^1.0",
        "phpstan/phpstan-symfony": "^1.0",
        "phpstan/phpstan-webmozart-assert": "^1.0",
        "phpunit/phpunit": "^9.5",
        "sylius-labs/coding-standard": "^2.0",
        "symfony/browser-kit": "^3.4|^4.1|^5.0",
        "symfony/debug-bundle": "^3.4|^4.1|^5.0",
        "symfony/dotenv": "^4.2|^5.0",
        "symfony/intl": "^3.4|^4.1|^5.0",
        "symfony/web-profiler-bundle": "^3.4|^4.1|^5.0",
        "symfony/web-server-bundle": "^3.4|^4.1"
    },
    "conflict": {
        "doctrine/doctrine-bundle": "<1.9",
        "symfony/symfony": "4.1.8",
        "symfony/browser-kit": "4.1.8",
        "symfony/dependency-injection": "4.1.8",
        "symfony/dom-crawler": "4.1.8",
        "symfony/routing": "4.1.8"
    },
    "config": {
        "audit": {
            "block-insecure": false
        },
        "allow-plugins": {
            "symfony/thanks": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "MangoSylius\\OrderCommentsPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": ["tests/Application/Kernel.php"],
        "psr-4": {
            "Tests\\MangoSylius\\OrderCommentsPlugin\\": "tests/"
        }
    }
}
